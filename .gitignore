# ==============================================================================
# FedUA-Net: Open-Science Publication .gitignore
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments & Packages
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# PyTorch Caches & Model Weights
.torch_cache/
*.pt
*.pth
*.bin
*.onnx
outputs_final/models/
outputs_experiments/models/
results/**/models/

# Experiments & Logs
outputs_*/
wandb/
runs/
*.log

# Large Datasets
Dataset/
data/
datasets/
*.zip
*.tar
*.tar.gz
*.7z

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary Scratch Files & Word Locks
scratch/
~$*
temp/
*.tmp
*.docx
baseline_report.txt

# LaTeX Build Intermediate Artifacts (keep paper.tex, paper.pdf, paper_figures/)
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out
